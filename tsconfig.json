{
  "compilerOptions": {
    "baseUrl": "./", 
    "target": "es2023",
    
    "moduleResolution": "node",
    "module": "commonjs",
    "lib": ["es2023"],
    "noEmit": true,
    "allowJs": true,
    "removeComments": false,

    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,

    //"noUnusedLocals": true,
    //"noUnusedParameters": true,
    //"noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": [
    "FolderMy/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
